# Copy to .env.local and fill in. Vite only exposes VITE_-prefixed vars to the
# browser — the Anthropic and Stripe secret keys deliberately are not here.
# Those live in Supabase Edge Function secrets (see README).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
